# AI Usage Dashboard — Configuração de Ambiente
# Copie este arquivo para .env e preencha conforme necessário
# NUNCA commite o arquivo .env com credenciais reais

# Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Chave de criptografia interna (usada pelo Fernet para criptografar chaves no SQLite)
SECRET_KEY=sua-chave-secreta-aleatoria-de-pelo-menos-32-caracteres

# Banco de dados (SQLite assíncrono padrão)
DATABASE_URL=sqlite+aiosqlite:///./data/dashboard.db

# Provedores pré-configurados (Opcional — alternativa à configuração via interface)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# TTL do Cache em segundos
CACHE_TTL=30

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
