# AI Usage Dashboard — Configuração de Ambiente
# Copie este arquivo para .env e preencha conforme necessário
# NUNCA commite o arquivo .env com credenciais reais

# Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=false
# Em produção (Render / Cloud / Docker), defina estritamente:
# ENVIRONMENT=production
ENVIRONMENT=development

# Segurança: Chave mestra (OBRIGATÓRIA em produção com 32+ caracteres, recomendado 64 hex)
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sua-chave-secreta-aleatoria-de-pelo-menos-32-caracteres
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_API_KEY=

# Controles de Hardening (SSRF / Ollama / BYOK)
OLLAMA_ALLOW_LAN=false
ALLOW_CUSTOM_PROVIDER_URLS=false
GATEWAY_ALLOW_BYOK=true

# Banco de dados:
# Desenvolvimento local (SQLite assíncrono padrão):
DATABASE_URL=sqlite+aiosqlite:///./data/dashboard.db
# Produção (PostgreSQL em Render / Neon / Supabase):
# Strings com 'postgres://' ou 'postgresql://' são automaticamente normalizadas para 'postgresql+asyncpg://'
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/tokenpulse?sslmode=require

# Provedores pré-configurados (Opcional — alternativa à configuração via interface)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# TTL do Cache em segundos
CACHE_TTL=30

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
